{
  // ==========================================================================
  // Cambridge Inventory Management - Development Configuration Template
  // ==========================================================================
  // Purpose: Complete example configuration for local development
  // Instructions:
  //   1. Copy this file to appsettings.Development.json (gitignored)
  //   2. Replace placeholder values with your test environment details
  //   3. Never commit appsettings.Development.json (contains secrets)
  // ==========================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Debug",                          // Verbose for development
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"      // Reduce HTTP noise
    }
  },

  // ==========================================================================
  // Serilog Configuration (structured logging)
  // ==========================================================================
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/inventory-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },

  // ==========================================================================
  // SQL Server Configuration
  // ==========================================================================
  "Sql": {
    "ConnectionString": "Server=localhost;Database=ProdSpt_Inventory;Integrated Security=true;TrustServerCertificate=true;",
    "CommandTimeoutSeconds": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10
  },

  // ==========================================================================
  // SQLite Buffer Configuration (for SQL Server outages)
  // ==========================================================================
  "SqliteBuffer": {
    "DatabasePath": "%ProgramData%\\CambridgeInventory\\buffer.db",  // Will expand environment variable
    "MaxPendingBatches": 1000,
    "AutoPurgeUploadedAfterDays": 7,
    "AutoPurgeFailedAfterDays": 30
  },

  // ==========================================================================
  // F5 BIG-IP Configuration
  // ==========================================================================
  "F5": {
    "Devices": [
      {
        "Name": "F5-Device-01",
        "BaseUrl": "https://f5-01.test.cambridge.local",
        "Username": "serviceaccount",                    // Stored in Azure Key Vault in production
        "PasswordSecretName": "F5-ServiceAccount-Password",  // Azure Key Vault secret name
        "Partition": "Common",
        "Enabled": true
      },
      {
        "Name": "F5-Device-02",
        "BaseUrl": "https://f5-02.test.cambridge.local",
        "Username": "serviceaccount",
        "PasswordSecretName": "F5-ServiceAccount-Password",
        "Partition": "Common",
        "Enabled": false                                 // Disable secondary device for testing
      }
    ],
    "RequestsPerSecond": 5,                              // Rate limit to avoid overwhelming F5
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },

  // ==========================================================================
  // WinRM Configuration
  // ==========================================================================
  "WinRM": {
    "MaxConcurrency": 5,                                 // Lower for dev (10 in production)
    "TimeoutSeconds": 60,
    "ServiceAccount": {
      "Username": "CAMBRIDGE\\svc_inventory",           // AD service account
      "PasswordSecretName": "WinRM-ServiceAccount-Password"  // Azure Key Vault secret name
    },
    "UseSSL": false,                                     // HTTP (5985) for dev, HTTPS (5986) for prod
    "SkipCaCheck": true,                                 // Allow self-signed certs in dev
    "SkipCnCheck": true
  },

  // ==========================================================================
  // Target Servers Configuration (ADR-009: Manual Discovery for Phase 1)
  // ==========================================================================
  "TargetServers": [
    // Development/Test Servers
    "testserver01.test.cambridge.local",
    "testserver02.test.cambridge.local",
    "testserver03.test.cambridge.local",
    "testserver04.test.cambridge.local",
    "testserver05.test.cambridge.local"

    // Production example (commented out for dev):
    // "prodweb01.cambridge.local",
    // "prodweb02.cambridge.local",
    // "prodapp01.cambridge.local",
    // ... (300 servers in production appsettings.json)
  ],

  // ==========================================================================
  // Harvest Schedule Configuration
  // ==========================================================================
  "Harvest": {
    "IntervalMinutes": 60,                               // Hourly for dev (daily in production = 1440)
    "StartupDelayMinutes": 1,                            // Wait 1 min after service start
    "EnableParallelHarvest": true
  },

  // ==========================================================================
  // Certificate Repository Configuration (CIFS Share)
  // ==========================================================================
  "CertificateRepository": {
    "UncPath": "\\\\fileserver.test.cambridge.local\\CertRepository$",
    "Username": "CAMBRIDGE\\svc_inventory",
    "PasswordSecretName": "CertRepo-ServiceAccount-Password",
    "SearchPattern": "*.pfx",
    "IncludeSubdirectories": true
  },

  // ==========================================================================
  // Teams Webhook Configuration (Weekly Digest)
  // ==========================================================================
  "Inventory": {
    "WeeklyDigest": {
      "Enabled": false,                                  // Disable in dev to avoid spam
      "DayOfWeek": "Monday",
      "HourUtc": 8,
      "WebhookUrlSecretName": "Teams-Webhook-Url",       // Azure Key Vault secret name
      "ExpirationThresholds": [30, 60, 90]               // Days until expiry
    }
  },

  // ==========================================================================
  // Azure Key Vault Configuration (Production Only)
  // ==========================================================================
  "AzureKeyVault": {
    "Enabled": false,                                    // Disabled in dev (use plaintext secrets)
    "VaultUri": "https://cambridgeinventory-test.vault.azure.net/",
    "UseManagedIdentity": true,                          // Recommended for production
    "TenantId": "00000000-0000-0000-0000-000000000000",  // Optional: explicit tenant
    "ClientId": "00000000-0000-0000-0000-000000000000",  // Optional: service principal
    "ClientSecretName": "AzureAD-ClientSecret"           // Optional: for non-managed identity auth
  },

  // ==========================================================================
  // Development Overrides (for testing specific scenarios)
  // ==========================================================================
  "Development": {
    "SimulateSqlOutage": false,                          // Force SQLite buffering for testing
    "SimulateF5Failure": false,                          // Test F5 error handling
    "MockWinRmResponses": false,                         // Use mock data instead of real WinRM
    "DisableRetryPolicies": false,                       // Fail fast for debugging
    "EnableDetailedErrorMessages": true
  }
}
