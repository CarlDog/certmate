{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet restore",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "restore"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "dotnet build",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "--nologo"
            ],
            "group": "build",
            "dependsOn": [
                "dotnet restore"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "dotnet test",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "--nologo",
                "--no-build",
                "--logger",
                "trx;LogFileName=test-results.trx"
            ],
            "group": "test",
            "dependsOn": [
                "dotnet build"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "dotnet format (check)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "tool",
                "run",
                "dotnet-format",
                "--",
                "--verify-no-changes"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "pre-commit-check",
            "dependsOrder": "sequence",
            "dependsOn": [
                "dotnet restore",
                "dotnet build",
                "dotnet format (check)",
                "dotnet test"
            ]
        }
    ]
}
