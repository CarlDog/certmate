#!/usr/bin/env bash
set -euo pipefail

# Canonical fleet pre-commit hook: identity allowlist + gitleaks +
# PII pattern scan. Generic by design — drop into any repo via the
# /install-precommit-hook skill or reference/install-hooks.{sh,ps1}.
# Contains NO repo-specific logic and NO baked-in PII: the patterns are
# generic so the hook itself is safe to commit publicly.
#
# Extend per-repo by appending project-specific checks AFTER section 3
# (e.g. a schema-drift gate) — keep sections 1-3 identical to the
# canonical version so the fleet stays in lockstep.

# Personal-domain email pattern, used by the PII scan over staged content
# (step 3). NOT used for the identity check — see step 1 for why a denylist
# is the wrong shape there.
PERSONAL_EMAIL_PATTERN='[A-Za-z0-9._%+-]+@(gmail|outlook|hotmail|yahoo|icloud|me|live|aol)\.[a-z]{2,}'

# 1. Author and committer identity check
#
# Allowlist, not denylist. A denylist of consumer domains can only block the
# domains someone thought to name: the 2026-08-31 audit found a corporate
# address as author of 81 commits in a public repo, matching nothing in the
# consumer list, unseen for a year. Accepting only the GitHub noreply alias
# catches every domain without naming any — which also keeps this hook safe
# to commit publicly, since naming a domain here would publish the exact
# string the check exists to keep out of sight.
#
# Both identities are checked. A commit can carry a correct noreply author
# and a personal-domain committer (a misconfigured machine, `git commit` from
# a stray shell); an author-only check passes those silently. That is not
# hypothetical — half the leaks found in this repo's own history were
# committer-side.
#
# Override per-clone where a different identity is genuinely required (a work
# repo on a corporate remote) — same out-of-band mechanism as
# fleet.internalHosts below, so no specific domain is ever committed:
#
#   git config fleet.allowedIdentityPattern '^[A-Za-z0-9._%+-]+@corp\.example$'
#
# Only the domain is constrained. Any local part is fine — a noreply address
# cannot carry a real mailbox whatever its prefix — which keeps both the
# `<id>+<login>` and bare `<login>` alias forms working, personal and work.
ALLOWED_IDENTITY_PATTERN=$(git config --get fleet.allowedIdentityPattern 2>/dev/null || true)
: "${ALLOWED_IDENTITY_PATTERN:=^[A-Za-z0-9._%+-]+@users\.noreply\.github\.com$}"

echo "Checking author identity..."
for role in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${role}_IDENT" 2>/dev/null || true)
  # git var returns "Name <email> timestamp tz" — extract the email.
  email=$(printf '%s' "$ident" | sed -nE 's/.*<([^>]+)>.*/\1/p')
  if ! printf '%s' "$email" | grep -qE "$ALLOWED_IDENTITY_PATTERN"; then
    role_lc=$(printf '%s' "$role" | tr '[:upper:]' '[:lower:]')
    echo "" >&2
    echo "Commit blocked: $role_lc identity is not an allowed email." >&2
    echo "  email:   ${email:-<unset>}" >&2
    echo "  allowed: $ALLOWED_IDENTITY_PATTERN" >&2
    echo "" >&2
    echo "Set a GitHub noreply alias for this repo:" >&2
    echo "  git config user.email '<numeric-id>+<github-login>@users.noreply.github.com'" >&2
    echo "" >&2
    echo "Find your numeric id at https://api.github.com/users/<login>" >&2
    echo "" >&2
    echo "If this repo legitimately needs a different identity:" >&2
    echo "  git config fleet.allowedIdentityPattern '<regex>'" >&2
    exit 1
  fi
done

# 2. Secret scan via gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks not installed. Install from https://github.com/gitleaks/gitleaks" >&2
  exit 1
fi

echo "Running gitleaks..."
# Use the repo's .gitleaks.toml when present (path exclusions, allowlists);
# fall back to gitleaks' default config so the hook works in any repo.
if [ -f .gitleaks.toml ]; then
  gitleaks protect --staged --redact --config .gitleaks.toml
else
  gitleaks protect --staged --redact
fi

# 3. PII pattern scan over staged content
# Catches user-home directory references and personal-domain email
# addresses that often leak into committed content (workstation paths,
# author identity, etc.). Patterns are deliberately generic so the hook
# can be committed publicly without itself containing any specific PII.
echo "Running PII pattern check..."

PII_PATTERNS=(
  '[/\\]Users[/\\][A-Za-z0-9._-]+[/\\]'
  '[/\\]home[/\\][A-Za-z0-9._-]+[/\\]'
  "$PERSONAL_EMAIL_PATTERN"
)

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
FOUND=0
if [ -n "$STAGED" ]; then
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    for pattern in "${PII_PATTERNS[@]}"; do
      matches=$(git show ":$file" 2>/dev/null | grep -nE "$pattern" || true)
      if [ -n "$matches" ]; then
        if [ "$FOUND" -eq 0 ]; then
          echo "" >&2
          echo "PII patterns detected in staged content:" >&2
          FOUND=1
        fi
        echo "  $file" >&2
        printf '%s\n' "$matches" | head -3 | sed 's/^/    /' >&2
      fi
    done
  done <<< "$STAGED"
fi

if [ "$FOUND" -ne 0 ]; then
  echo "" >&2
  echo "Scrub the matches and re-stage. To adjust patterns, edit .githooks/pre-commit." >&2
  exit 1
fi

echo "No PII patterns detected."

# --- certmate-specific checks (appended after canonical section 3) ---
# .NET build/format/test gate for the root InventoryManagement solution.
# (This repo also carries a duplicate copy under .inventorymanagement/,
# checked here — the root-level duplicate that used to sit here was
# removed 2026-08-28; see CLAUDE memory certmate-security-risk.md.)

SLN=".inventorymanagement/InventoryManagement.sln"

echo "[pre-commit] Restoring tools and solution..."
DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet tool restore >/dev/null 2>&1 || true
DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet restore "$SLN"

echo "[pre-commit] Formatting check (dotnet-format)..."
if dotnet format "$SLN" --verify-no-changes; then
  echo "[pre-commit] Formatting OK"
else
  echo "[pre-commit] Formatting issues found. Run: dotnet tool run dotnet-format"
  exit 1
fi

echo "[pre-commit] Building..."
DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet build "$SLN" --nologo

echo "[pre-commit] Running tests..."
DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet test "$SLN" --nologo --no-build --verbosity minimal --logger "trx;LogFileName=test-results.trx"

# Chain to the pre-commit-framework-managed hook (ruff/mypy/dotnet-format
# on .inventorymanagement — see .pre-commit-config.yaml). core.hooksPath
# now points at this directory instead of .git/hooks, so without this
# call those framework-managed checks would silently stop running.
echo "[pre-commit] Running pre-commit framework hooks (ruff/mypy/dotnet-format)..."
REPO_ROOT="$(git rev-parse --show-toplevel)"
"$REPO_ROOT/.git/hooks/pre-commit"

echo "[pre-commit] All checks passed."
